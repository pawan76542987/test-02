# ==============================================================================
# LabTrack - Environment Configuration Variables
# ==============================================================================

# Application Port (Render automatically sets PORT)
PORT=3000

# Runtime Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YourPasswordHere@cluster0.abcde.mongodb.net/lab_asset_management?retryWrites=true&w=majority

# Session Encryption Secret Key (Use a strong 32+ character random string in production)
SESSION_SECRET=your_super_secret_session_encryption_key_min_32_characters_long

# Reverse Proxy Trust (Set to 'true' if running behind Nginx / Cloudflare / Render proxy)
TRUST_PROXY=true
