<div class="auth-card auth-card-wide">
  <div class="auth-brand">
    <div class="auth-logo">LT</div>
    <h1 class="auth-title">Create Requester Account</h1>
    <p class="auth-subtitle">Register to request laboratory assets & equipment</p>
  </div>

  <form action="/auth/register" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label for="regName" class="form-label required">Full Name</label>
        <input 
          type="text" 
          id="regName" 
          name="name" 
          class="form-input" 
          placeholder="e.g. Rahul Sharma" 
          required
        >
      </div>

      <div class="form-group">
        <label for="regEmail" class="form-label required">Email Address</label>
        <input 
          type="email" 
          id="regEmail" 
          name="email" 
          class="form-input" 
          placeholder="e.g. rahul.sharma@labtrack.edu" 
          required
        >
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="regType" class="form-label required">Account Type</label>
        <select id="regType" name="userType" class="form-select" required>
          <option value="student">Student</option>
          <option value="staff">Staff / Researcher</option>
        </select>
        <span class="form-help">Lab In-charge and Admin accounts are managed by administrators.</span>
      </div>

      <div class="form-group">
        <label for="regDept" class="form-label">Department / School</label>
        <input 
          type="text" 
          id="regDept" 
          name="department" 
          class="form-input" 
          placeholder="e.g. Computer Science & Eng."
        >
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="regId" class="form-label">Roll No / Employee ID</label>
        <input 
          type="text" 
          id="regId" 
          name="idNumber" 
          class="form-input" 
          placeholder="e.g. 2024CS0142"
        >
      </div>

      <div class="form-group">
        <label for="regPhone" class="form-label">Contact Phone</label>
        <input 
          type="tel" 
          id="regPhone" 
          name="phone" 
          class="form-input" 
          placeholder="e.g. +91 9876543210"
        >
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="regPass" class="form-label required">Password</label>
        <div class="password-input-wrap">
          <input 
            type="password" 
            id="regPass" 
            name="password" 
            class="form-input" 
            placeholder="Min 6 characters" 
            required 
            minlength="6"
          >
          <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="regConfirm" class="form-label required">Confirm Password</label>
        <div class="password-input-wrap">
          <input 
            type="password" 
            id="regConfirm" 
            name="confirmPassword" 
            class="form-input" 
            placeholder="Re-enter password" 
            required 
            minlength="6"
          >
          <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 14px;">
      Complete Registration
    </button>
  </form>

  <div class="auth-footer">
    Already have an institutional account? <a href="/auth/login">Sign In</a>
  </div>
</div>
