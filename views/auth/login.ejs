<div class="auth-card">
  <div class="auth-brand">
    <div class="auth-logo">LT</div>
    <h1 class="auth-title">LabTrack Portal</h1>
    <p class="auth-subtitle">Institutional Lab Equipment & Asset Tracking</p>
  </div>

  <form action="/auth/login" method="POST" id="loginForm">
    <input type="hidden" name="returnTo" value="<%= typeof returnTo !== 'undefined' ? returnTo : '' %>">

    <div class="form-group">
      <label for="loginEmail" class="form-label required">Institutional Email</label>
      <input 
        type="email" 
        id="loginEmail" 
        name="email" 
        class="form-input" 
        placeholder="e.g. admin@labtrack.edu" 
        required 
        autocomplete="email"
      >
    </div>

    <div class="form-group">
      <label for="loginPassword" class="form-label required">Password</label>
      <div class="password-input-wrap">
        <input 
          type="password" 
          id="loginPassword" 
          name="password" 
          class="form-input" 
          placeholder="••••••••" 
          required 
          autocomplete="current-password"
        >
        <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">
      Sign In to Dashboard
    </button>
  </form>

  <!-- Quick Demo Credentials Box -->
  <div class="demo-credentials-box" style="margin-top: 24px; padding: 18px; border-radius: var(--radius-md); background-color: rgba(15, 23, 42, 0.85); border: 1px solid rgba(255, 255, 255, 0.12);">
    <div class="demo-credentials-title" style="color: #60a5fa; font-weight: 700; font-size: 0.85rem; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between;">
      <span>⚡ Quick Demo Login Accounts</span>
      <span style="font-size: 0.72rem; color: #94a3b8; font-weight: normal;">Click any account to auto-fill</span>
    </div>
    
    <div class="demo-account-list" style="display: flex; flex-direction: column; gap: 10px;">
      <!-- 1. Admin -->
      <div class="demo-item" style="display: flex; align-items: center; justify-content: space-between; background: rgba(30, 41, 59, 0.6); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.06);">
        <div style="font-size: 0.8rem;">
          <div style="color: #f8fafc; font-weight: 600;">👑 Administrator</div>
          <div style="color: #cbd5e1; font-family: monospace; font-size: 0.75rem;">admin@labtrack.edu</div>
          <div style="color: #93c5fd; font-family: monospace; font-size: 0.73rem;">Pass: <strong>Admin@12345</strong></div>
        </div>
        <button type="button" class="btn btn-primary btn-sm demo-fill-btn" data-email="admin@labtrack.edu" data-pass="Admin@12345" style="padding: 4px 10px; font-size: 0.75rem;">
          Fill & Sign In
        </button>
      </div>

      <!-- 2. Lab In-Charge -->
      <div class="demo-item" style="display: flex; align-items: center; justify-content: space-between; background: rgba(30, 41, 59, 0.6); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.06);">
        <div style="font-size: 0.8rem;">
          <div style="color: #f8fafc; font-weight: 600;">🔬 Lab In-Charge (CS & IoT)</div>
          <div style="color: #cbd5e1; font-family: monospace; font-size: 0.75rem;">incharge.cs@labtrack.edu</div>
          <div style="color: #93c5fd; font-family: monospace; font-size: 0.73rem;">Pass: <strong>Lab@12345</strong></div>
        </div>
        <button type="button" class="btn btn-primary btn-sm demo-fill-btn" data-email="incharge.cs@labtrack.edu" data-pass="Lab@12345" style="padding: 4px 10px; font-size: 0.75rem;">
          Fill & Sign In
        </button>
      </div>

      <!-- 3. Student -->
      <div class="demo-item" style="display: flex; align-items: center; justify-content: space-between; background: rgba(30, 41, 59, 0.6); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.06);">
        <div style="font-size: 0.8rem;">
          <div style="color: #f8fafc; font-weight: 600;">🎓 Student (CSE)</div>
          <div style="color: #cbd5e1; font-family: monospace; font-size: 0.75rem;">student.rahul@labtrack.edu</div>
          <div style="color: #93c5fd; font-family: monospace; font-size: 0.73rem;">Pass: <strong>User@12345</strong></div>
        </div>
        <button type="button" class="btn btn-primary btn-sm demo-fill-btn" data-email="student.rahul@labtrack.edu" data-pass="User@12345" style="padding: 4px 10px; font-size: 0.75rem;">
          Fill & Sign In
        </button>
      </div>

      <!-- 4. Staff -->
      <div class="demo-item" style="display: flex; align-items: center; justify-content: space-between; background: rgba(30, 41, 59, 0.6); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.06);">
        <div style="font-size: 0.8rem;">
          <div style="color: #f8fafc; font-weight: 600;">💼 Staff / Researcher</div>
          <div style="color: #cbd5e1; font-family: monospace; font-size: 0.75rem;">staff.priya@labtrack.edu</div>
          <div style="color: #93c5fd; font-family: monospace; font-size: 0.73rem;">Pass: <strong>User@12345</strong></div>
        </div>
        <button type="button" class="btn btn-primary btn-sm demo-fill-btn" data-email="staff.priya@labtrack.edu" data-pass="User@12345" style="padding: 4px 10px; font-size: 0.75rem;">
          Fill & Sign In
        </button>
      </div>
    </div>
  </div>

  <div class="auth-footer">
    Don't have an account? <a href="/auth/register">Register as Student / Staff</a>
  </div>
</div>

<script>
  // Robust Demo Fill Event Handlers
  document.addEventListener('DOMContentLoaded', () => {
    const demoBtns = document.querySelectorAll('.demo-fill-btn');
    const emailInput = document.getElementById('loginEmail');
    const passwordInput = document.getElementById('loginPassword');
    const loginForm = document.getElementById('loginForm');

    demoBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const email = btn.getAttribute('data-email');
        const pass = btn.getAttribute('data-pass');

        if (emailInput && passwordInput) {
          emailInput.value = email;
          passwordInput.value = pass;
          
          // Visual highlight animation
          emailInput.style.borderColor = '#3b82f6';
          passwordInput.style.borderColor = '#3b82f6';
          emailInput.style.boxShadow = '0 0 0 3px rgba(59, 130, 246, 0.35)';
          passwordInput.style.boxShadow = '0 0 0 3px rgba(59, 130, 246, 0.35)';

          setTimeout(() => {
            if (loginForm) {
              loginForm.submit();
            }
          }, 200);
        }
      });
    });
  });
</script>
