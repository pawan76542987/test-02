<div class="card" style="max-width: 800px; margin: 0 auto;">
  <div class="card-header">
    <div>
      <h2 class="card-title">User Account Profile</h2>
      <p class="card-subtitle">Manage your personal and contact details</p>
    </div>
    <span class="badge badge-purple">
      <%= profileUser.role.toUpperCase() %>
    </span>
  </div>

  <form action="/auth/profile" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input type="text" name="name" class="form-input" value="<%= profileUser.name %>" required>
      </div>

      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" class="form-input" value="<%= profileUser.email %>" disabled style="background-color: var(--bg-subtle);">
        <span class="form-help">Institutional email cannot be modified.</span>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Department / Faculty</label>
        <input type="text" name="department" class="form-input" value="<%= profileUser.department || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label">Roll No / Staff ID</label>
        <input type="text" name="idNumber" class="form-input" value="<%= profileUser.idNumber || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Contact Phone</label>
        <input type="tel" name="phone" class="form-input" value="<%= profileUser.phone || '' %>">
      </div>

      <div class="form-group">
        <label class="form-label">Account Role</label>
        <input type="text" class="form-input" value="<%= profileUser.role.toUpperCase() %> (<%= profileUser.userType %>)" disabled style="background-color: var(--bg-subtle);">
      </div>
    </div>

    <% if (profileUser.assignedLabs && profileUser.assignedLabs.length > 0) { %>
      <div class="form-group">
        <label class="form-label">Assigned Laboratory Locations</label>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px;">
          <% profileUser.assignedLabs.forEach(function(lab) { %>
            <span class="badge badge-info">🏛 <%= lab.name %> (<%= lab.code %>)</span>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div style="display: flex; justify-content: flex-end; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
      <button type="submit" class="btn btn-primary">
        Save Profile Changes
      </button>
    </div>
  </form>
</div>
