<!-- Requester Hero Banner -->
<div class="quick-action-banner">
  <div class="quick-action-content">
    <h2>Welcome, <%= currentUser.name %>!</h2>
    <p>Explore institutional laboratory equipment, place issue requests, and track your active equipment borrowings.</p>
  </div>
  <div class="quick-action-buttons">
    <a href="/assets" class="btn btn-primary">Browse Equipment Catalog</a>
    <a href="/requests/new" class="btn btn-secondary">+ Request Equipment</a>
  </div>
</div>

<!-- Requester Stats Grid -->
<div class="stats-grid">
  <div class="stat-card stat-amber">
    <div class="stat-icon-wrapper">⏳</div>
    <div class="stat-content">
      <span class="stat-value"><%= stats.pendingCount %></span>
      <span class="stat-label">Pending Approval</span>
      <span class="stat-subtext">Awaiting lab review</span>
    </div>
  </div>

  <div class="stat-card stat-blue">
    <div class="stat-icon-wrapper">✓</div>
    <div class="stat-content">
      <span class="stat-value"><%= stats.approvedCount %></span>
      <span class="stat-label">Approved & Ready</span>
      <span class="stat-subtext">Pick up from laboratory</span>
    </div>
  </div>

  <div class="stat-card stat-purple">
    <div class="stat-icon-wrapper">📦</div>
    <div class="stat-content">
      <span class="stat-value"><%= stats.issuedCount %></span>
      <span class="stat-label">Currently Borrowed</span>
      <span class="stat-subtext">In your possession</span>
    </div>
  </div>

  <div class="stat-card stat-red">
    <div class="stat-icon-wrapper">⚠</div>
    <div class="stat-content">
      <span class="stat-value"><%= stats.overdueCount %></span>
      <span class="stat-label">Overdue Returns</span>
      <span class="stat-subtext">Please return immediately</span>
    </div>
  </div>

  <div class="stat-card stat-green">
    <div class="stat-icon-wrapper">📜</div>
    <div class="stat-content">
      <span class="stat-value"><%= stats.returnedCount %></span>
      <span class="stat-label">Returned History</span>
      <span class="stat-subtext">Completed borrow cycles</span>
    </div>
  </div>
</div>

<!-- Active Borrowings / Requests in Progress -->
<div class="card" style="margin-bottom: 28px;">
  <div class="card-header">
    <div>
      <h3 class="card-title">My Active Requests & Handed-Over Equipment</h3>
      <p class="card-subtitle">Equipment currently in review, ready for pickup, or in your possession</p>
    </div>
    <a href="/requests" class="btn btn-secondary btn-sm">View All Requests</a>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Request Code</th>
          <th>Equipment</th>
          <th>Lab Location</th>
          <th>Units</th>
          <th>Expected Return</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (stats.activeRequests && stats.activeRequests.length > 0) { %>
          <% stats.activeRequests.forEach(function(req) { %>
            <tr>
              <td>
                <a href="/requests/<%= req._id %>" style="font-weight: 700; color: var(--color-primary); text-decoration: none;">
                  <%= req.requestCode %>
                </a>
                <div style="font-size: 0.72rem; color: var(--text-muted);"><%= new Date(req.createdAt).toLocaleDateString() %></div>
              </td>
              <td>
                <strong><%= req.asset?.name %></strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= req.asset?.assetTag %></div>
              </td>
              <td>
                <div><%= req.lab?.name %></div>
                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= req.lab?.building %> - <%= req.lab?.roomNumber %></div>
              </td>
              <td><strong><%= req.requestedQuantity %></strong></td>
              <td>
                <%= new Date(req.expectedReturnDate).toLocaleDateString() %>
                <% if (req.isOverdue) { %>
                  <div style="color: var(--status-danger); font-size: 0.72rem; font-weight: 700;">
                    OVERDUE (<%= req.daysOverdue %> days)
                  </div>
                <% } %>
              </td>
              <td>
                <% if (req.status === 'pending') { %>
                  <span class="badge badge-warning"><span class="badge-dot"></span>Pending Review</span>
                <% } else if (req.status === 'approved') { %>
                  <span class="badge badge-info"><span class="badge-dot"></span>Approved (Pickup Ready)</span>
                <% } else if (req.status === 'issued') { %>
                  <% if (req.isOverdue) { %>
                    <span class="badge badge-danger"><span class="badge-dot"></span>Overdue</span>
                  <% } else { %>
                    <span class="badge badge-purple"><span class="badge-dot"></span>Issued / In Hand</span>
                  <% } %>
                <% } %>
              </td>
              <td>
                <div class="table-actions">
                  <a href="/requests/<%= req._id %>" class="btn btn-secondary btn-sm">View</a>
                  <% if (req.status === 'pending') { %>
                    <form action="/requests/<%= req._id %>/cancel" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to cancel this request?');">
                      <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7">
              <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h4 class="empty-title">No Active Borrowings</h4>
                <p class="empty-desc">You currently have no pending requests or borrowed equipment.</p>
                <a href="/assets" class="btn btn-primary btn-sm" style="margin-top: 8px;">Explore Equipment Catalog</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
