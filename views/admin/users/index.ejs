<!-- User Management Header -->
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
  <div>
    <h2 style="font-size: 1.25rem; font-weight: 700;">Institutional User Directory</h2>
    <p style="font-size: 0.82rem; color: var(--text-muted);">
      Manage role authorizations, staff accounts, lab in-charges, and active permissions
    </p>
  </div>

  <a href="/admin/users/create" class="btn btn-primary btn-sm">+ Create Privileged Account</a>
</div>

<!-- Filter Toolbar -->
<div class="card" style="margin-bottom: 20px; padding: 16px;">
  <form action="/admin/users" method="GET" style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
    <div style="flex: 1; min-width: 180px;">
      <input 
        type="text" 
        name="q" 
        class="form-input" 
        placeholder="Search by name, email, roll no, or department..." 
        value="<%= filters.q || '' %>"
      >
    </div>

    <div style="min-width: 150px;">
      <select name="role" class="form-select" onchange="this.form.submit()">
        <option value="all">All Roles</option>
        <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Administrators</option>
        <option value="lab_incharge" <%= filters.role === 'lab_incharge' ? 'selected' : '' %>>Lab In-Charges</option>
        <option value="student" <%= filters.role === 'student' ? 'selected' : '' %>>Students</option>
        <option value="staff" <%= filters.role === 'staff' ? 'selected' : '' %>>Staff / Faculty</option>
      </select>
    </div>

    <div style="min-width: 130px;">
      <select name="status" class="form-select" onchange="this.form.submit()">
        <option value="all">All Statuses</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active Only</option>
        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Deactivated</option>
      </select>
    </div>

    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/admin/users" class="btn btn-secondary btn-sm">Reset</a>
  </form>
</div>

<!-- Users Table -->
<% if (users && users.length > 0) { %>
  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Role & Type</th>
          <th>Department</th>
          <th>ID / Phone</th>
          <th>Assigned Labs</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td>
              <div style="font-weight: 700;"><%= u.name %></div>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= u.email %></div>
            </td>
            <td>
              <% if (u.role === 'admin') { %>
                <span class="badge badge-danger">Administrator</span>
              <% } else if (u.role === 'lab_incharge') { %>
                <span class="badge badge-purple">Lab In-Charge</span>
              <% } else if (u.role === 'staff') { %>
                <span class="badge badge-info">Staff</span>
              <% } else { %>
                <span class="badge badge-neutral">Student</span>
              <% } %>
            </td>
            <td><%= u.department || 'N/A' %></td>
            <td>
              <div><%= u.idNumber || 'No ID' %></div>
              <div style="font-size: 0.72rem; color: var(--text-muted);"><%= u.phone || '' %></div>
            </td>
            <td>
              <% if (u.assignedLabs && u.assignedLabs.length > 0) { %>
                <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                  <% u.assignedLabs.forEach(function(lab) { %>
                    <span class="badge badge-neutral" style="font-size: 0.7rem;"><%= lab.code %></span>
                  <% }); %>
                </div>
              <% } else { %>
                <span style="color: var(--text-muted); font-size: 0.75rem;">None</span>
              <% } %>
            </td>
            <td>
              <% if (u.isActive) { %>
                <span class="badge badge-success"><span class="badge-dot"></span>Active</span>
              <% } else { %>
                <span class="badge badge-danger"><span class="badge-dot"></span>Inactive</span>
              <% } %>
            </td>
            <td>
              <div class="table-actions">
                <a href="/admin/users/<%= u._id %>/history" class="btn btn-secondary btn-sm" title="View Borrowing History">History</a>
                
                <% if (u._id.toString() !== currentUser._id.toString()) { %>
                  <form action="/admin/users/<%= u._id %>/toggle" method="POST" style="display: inline;">
                    <button type="submit" class="btn <%= u.isActive ? 'btn-secondary' : 'btn-success' %> btn-sm" style="<%= u.isActive ? 'color: var(--status-danger);' : '' %>">
                      <%= u.isActive ? 'Deactivate' : 'Activate' %>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <%- include('../../partials/pagination') %>
  </div>
<% } else { %>
  <div class="card">
    <div class="empty-state">
      <div class="empty-icon">👥</div>
      <h3 class="empty-title">No Users Found</h3>
      <p class="empty-desc">No registered user matches your current search parameters.</p>
    </div>
  </div>
<% } %>
