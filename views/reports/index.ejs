<!-- Reports Header -->
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
  <div>
    <h2 style="font-size: 1.25rem; font-weight: 700;">Institutional Asset Reports & Analytics</h2>
    <p style="font-size: 0.82rem; color: var(--text-muted);">
      Generate audit reports, track utilization trends, and export verified datasets
    </p>
  </div>

  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
    <a href="/reports/export/assets?category=<%= filters.category || 'all' %>&lab=<%= filters.lab || 'all' %>" class="btn btn-secondary btn-sm">
      📥 Export Assets CSV
    </a>
    <a href="/reports/export/requests?startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&status=<%= filters.status || 'all' %>" class="btn btn-primary btn-sm">
      📥 Export Transactions CSV
    </a>
  </div>
</div>

<!-- Filter Toolbar -->
<div class="card" style="margin-bottom: 24px; padding: 20px;">
  <form action="/reports" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; align-items: end;">
    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label" style="font-size: 0.78rem;">Start Date</label>
      <input type="date" name="startDate" class="form-input" value="<%= filters.startDate || '' %>">
    </div>

    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label" style="font-size: 0.78rem;">End Date</label>
      <input type="date" name="endDate" class="form-input" value="<%= filters.endDate || '' %>">
    </div>

    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label" style="font-size: 0.78rem;">Category</label>
      <select name="category" class="form-select">
        <option value="all">All Categories</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c._id %>" <%= filters.category === c._id.toString() ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label" style="font-size: 0.78rem;">Laboratory</label>
      <select name="lab" class="form-select">
        <option value="all">All Laboratories</option>
        <% labs.forEach(function(l) { %>
          <option value="<%= l._id %>" <%= filters.lab === l._id.toString() ? 'selected' : '' %>><%= l.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label" style="font-size: 0.78rem;">Request Status</label>
      <select name="status" class="form-select">
        <option value="all">All Statuses</option>
        <option value="issued" <%= filters.status === 'issued' ? 'selected' : '' %>>Currently Issued</option>
        <option value="returned" <%= filters.status === 'returned' ? 'selected' : '' %>>Returned</option>
        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      </select>
    </div>

    <div style="display: flex; gap: 8px;">
      <button type="submit" class="btn btn-primary btn-sm" style="flex: 1;">Filter Report</button>
      <a href="/reports" class="btn btn-secondary btn-sm">Reset</a>
    </div>
  </form>
</div>

<!-- Aggregated Summary Cards -->
<div class="stats-grid">
  <div class="stat-card stat-blue">
    <div class="stat-icon-wrapper">📦</div>
    <div class="stat-content">
      <span class="stat-value"><%= reportData.summary.totalAssetsCount %></span>
      <span class="stat-label">Matching Assets</span>
      <span class="stat-subtext">Filtered inventory records</span>
    </div>
  </div>

  <div class="stat-card stat-purple">
    <div class="stat-icon-wrapper">📋</div>
    <div class="stat-content">
      <span class="stat-value"><%= reportData.summary.totalRequestsCount %></span>
      <span class="stat-label">Transaction Requests</span>
      <span class="stat-subtext">Total issue records</span>
    </div>
  </div>

  <div class="stat-card stat-green">
    <div class="stat-icon-wrapper">🔄</div>
    <div class="stat-content">
      <span class="stat-value"><%= reportData.summary.totalIssuedUnits %></span>
      <span class="stat-label">Units Currently Handed Over</span>
      <span class="stat-subtext">In active circulation</span>
    </div>
  </div>

  <div class="stat-card stat-amber">
    <div class="stat-icon-wrapper">⚠</div>
    <div class="stat-content">
      <span class="stat-value"><%= reportData.summary.totalDamagedUnits %></span>
      <span class="stat-label">Damaged Return Units</span>
      <span class="stat-subtext">Recorded during check-in</span>
    </div>
  </div>

  <div class="stat-card stat-red">
    <div class="stat-icon-wrapper">❌</div>
    <div class="stat-content">
      <span class="stat-value"><%= reportData.summary.totalLostUnits %></span>
      <span class="stat-label">Lost Units Recorded</span>
      <span class="stat-subtext">Discrepancy count</span>
    </div>
  </div>

  <div class="stat-card stat-sky">
    <div class="stat-icon-wrapper">₹</div>
    <div class="stat-content">
      <span class="stat-value">₹<%= reportData.summary.totalMaintenanceCost.toLocaleString() %></span>
      <span class="stat-label">Total Maintenance Expense</span>
      <span class="stat-subtext">Logged repair costs</span>
    </div>
  </div>
</div>

<!-- Transaction History Data Table -->
<div class="card">
  <div class="card-header">
    <div>
      <h3 class="card-title">Transaction & Issue Request Audit Log</h3>
      <p class="card-subtitle">Detailed record of equipment borrowings matching the selected filters</p>
    </div>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Request Code</th>
          <th>Requester</th>
          <th>Equipment</th>
          <th>Location</th>
          <th>Qty</th>
          <th>Status</th>
          <th>Request Date</th>
          <th>Handover By</th>
          <th>Return Condition</th>
        </tr>
      </thead>
      <tbody>
        <% if (reportData.requests && reportData.requests.length > 0) { %>
          <% reportData.requests.forEach(function(req) { %>
            <tr>
              <td>
                <a href="/requests/<%= req._id %>" style="font-weight: 700; color: var(--color-primary); text-decoration: none;">
                  <%= req.requestCode %>
                </a>
              </td>
              <td>
                <div><%= req.requester?.name %></div>
                <div style="font-size: 0.72rem; color: var(--text-muted);"><%= req.requester?.idNumber || req.requester?.email %></div>
              </td>
              <td>
                <strong><%= req.asset?.name %></strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= req.asset?.assetTag %></div>
              </td>
              <td><%= req.lab?.name %></td>
              <td><strong><%= req.requestedQuantity %></strong></td>
              <td>
                <span class="badge badge-neutral" style="text-transform: capitalize;"><%= req.status %></span>
              </td>
              <td><%= req.createdAt ? new Date(req.createdAt).toLocaleDateString() : 'N/A' %></td>
              <td><%= req.issuedBy?.name || 'N/A' %></td>
              <td>
                <% if (req.returnCondition) { %>
                  <span class="badge <%= req.returnCondition === 'ok' ? 'badge-success' : 'badge-danger' %>">
                    <%= req.returnCondition.toUpperCase() %>
                  </span>
                <% } else { %>
                  <span style="color: var(--text-muted); font-size: 0.78rem;">-</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="9" style="text-align: center; color: var(--text-muted); padding: 32px;">
              No request transactions found for the specified filter criteria.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
