<div class="card" style="max-width: 800px; margin: 0 auto;">
  <div class="card-header">
    <div>
      <h2 class="card-title">Submit Equipment Issue Request</h2>
      <p class="card-subtitle">Request laboratory equipment or instrumentation for academic and research projects</p>
    </div>
    <a href="/assets" class="btn btn-secondary btn-sm">Browse Catalog</a>
  </div>

  <form action="/requests" method="POST" id="issueRequestForm">
    <!-- Equipment Selection -->
    <div class="form-group">
      <label for="assetSelect" class="form-label required">Select Laboratory Equipment</label>
      <select id="assetSelect" name="assetId" class="form-select" required onchange="handleAssetChange()">
        <option value="">-- Choose Equipment from Active Catalog --</option>
        <% availableAssets.forEach(function(asset) { %>
          <option 
            value="<%= asset._id %>" 
            data-avail="<%= asset.availableQuantity %>" 
            data-tag="<%= asset.assetTag %>"
            data-lab="<%= asset.lab?.name %>"
            <%= selectedAsset && selectedAsset._id.toString() === asset._id.toString() ? 'selected' : '' %>
          >
            <%= asset.name %> (<%= asset.assetTag %>) &bull; <%= asset.availableQuantity %> Available in <%= asset.lab?.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <!-- Selected Asset Real-Time Availability Callout -->
    <div id="availabilityCallout" style="padding: 14px 18px; border-radius: var(--radius-md); background-color: var(--color-primary-subtle); border: 1px solid #bfdbfe; margin-bottom: 20px; display: <%= selectedAsset ? 'flex' : 'none' %>; justify-content: space-between; align-items: center;">
      <div>
        <div style="font-weight: 700; color: var(--color-primary); font-size: 0.92rem;" id="calloutName">
          <%= selectedAsset ? selectedAsset.name : '' %>
        </div>
        <div style="font-size: 0.78rem; color: var(--text-muted);" id="calloutDetails">
          <%= selectedAsset ? `Asset Tag: ${selectedAsset.assetTag} | Location: ${selectedAsset.lab?.name}` : '' %>
        </div>
      </div>
      <div>
        <span class="badge badge-success" style="font-size: 0.85rem;" id="calloutStock">
          <%= selectedAsset ? `${selectedAsset.availableQuantity} Units Available` : '' %>
        </span>
      </div>
    </div>

    <div class="form-row">
      <!-- Quantity Input -->
      <div class="form-group">
        <label for="requestedQuantity" class="form-label required">Requested Quantity</label>
        <input 
          type="number" 
          id="requestedQuantity" 
          name="requestedQuantity" 
          class="form-input" 
          min="1" 
          max="<%= selectedAsset ? selectedAsset.availableQuantity : 100 %>" 
          value="1" 
          required
        >
        <span class="form-help" id="quantityHelp">Cannot exceed currently available inventory.</span>
      </div>

      <!-- Expected Return Date -->
      <div class="form-group">
        <label for="expectedReturnDate" class="form-label required">Expected Return Date</label>
        <input 
          type="date" 
          id="expectedReturnDate" 
          name="expectedReturnDate" 
          class="form-input" 
          required
        >
        <span class="form-help">Must be today or a future date.</span>
      </div>
    </div>

    <!-- Purpose of Request -->
    <div class="form-group">
      <label for="purpose" class="form-label required">Purpose of Borrowing / Project Details</label>
      <textarea 
        id="purpose" 
        name="purpose" 
        class="form-textarea" 
        rows="4" 
        placeholder="Specify the course, lab experiment, capstone project, or research task requiring this equipment..." 
        required 
        maxlength="500"
      ></textarea>
      <span class="form-help">Max 500 characters. Reviewers evaluate your stated purpose for approval.</span>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
      <a href="/assets" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary" id="submitBtn">
        Submit Issue Request
      </button>
    </div>
  </form>
</div>

<script>
  // Set minimum date to today
  document.addEventListener('DOMContentLoaded', () => {
    const today = new Date().toISOString().split('T')[0];
    const returnDateInput = document.getElementById('expectedReturnDate');
    if (returnDateInput) {
      returnDateInput.min = today;
      // Default to 7 days from today
      const nextWeek = new Date();
      nextWeek.setDate(nextWeek.getDate() + 7);
      returnDateInput.value = nextWeek.toISOString().split('T')[0];
    }
  });

  function handleAssetChange() {
    const select = document.getElementById('assetSelect');
    const selectedOption = select.options[select.selectedIndex];
    const callout = document.getElementById('availabilityCallout');
    const qtyInput = document.getElementById('requestedQuantity');
    const qtyHelp = document.getElementById('quantityHelp');

    if (selectedOption && selectedOption.value) {
      const avail = parseInt(selectedOption.getAttribute('data-avail'), 10) || 0;
      const tag = selectedOption.getAttribute('data-tag');
      const lab = selectedOption.getAttribute('data-lab');
      const name = selectedOption.text.split('(')[0].trim();

      document.getElementById('calloutName').textContent = name;
      document.getElementById('calloutDetails').textContent = `Asset Tag: ${tag} | Location: ${lab}`;
      document.getElementById('calloutStock').textContent = `${avail} Units Available`;
      callout.style.display = 'flex';

      qtyInput.max = avail;
      if (parseInt(qtyInput.value, 10) > avail) {
        qtyInput.value = Math.max(1, avail);
      }
      qtyHelp.textContent = `Max available right now: ${avail} units.`;
    } else {
      callout.style.display = 'none';
      qtyInput.max = 100;
      qtyHelp.textContent = 'Cannot exceed currently available inventory.';
    }
  }
</script>
