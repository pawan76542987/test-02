<div class="card" style="max-width: 600px; margin: 40px auto; text-align: center; padding: 48px 32px;">
  <div style="font-size: 64px; color: var(--color-primary); margin-bottom: 16px;">🔍</div>
  <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 8px;">404 - Page Not Found</h1>
  <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 24px;">
    The requested resource or page <code style="background: var(--bg-app); padding: 2px 6px; border-radius: 4px;"><%= typeof path !== 'undefined' ? path : '' %></code> could not be found.
  </p>
  <div style="display: flex; gap: 12px; justify-content: center;">
    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
    <a href="/assets" class="btn btn-secondary">Equipment Catalog</a>
  </div>
</div>
